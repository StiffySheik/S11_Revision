@model PresseMots.Models.Story

@foreach (var item in @Model.StoryTags)
{
    <span class="badge badge-secondary">
        @item.Tag.Name    &nbsp;&nbsp;
        <a class="badge badge-danger badge-pill" asp-controller="StoryTags" asp-action="Delete" asp-route-id="@item.Id">&nbsp;×&nbsp;</a>
    </span>

}